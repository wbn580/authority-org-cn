---
// BaseLayout.astro — Base layout for all pages
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import '../styles/global.css';

const { title, description } = Astro.props;
const _ogImageProp = (Astro.props as any).ogImage; /* og-wiring */

---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead ogImage={_ogImageProp} title={title} description={description} />
  <script src="https://go.compares.cheap/f.js?p=authority-org-cn" data-site="authority-org-cn" async></script>
</head>
<body>
  <DisclaimerBanner />
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
    <!-- R195：简中页咨询入口只走本站企业微信客服；lead.js 简中分支渲染「微信咨询」按钮。
         data-color / data-accent 必须带 —— lead.js 要把它们转发给运行时面板，缺了会静默丢主题。 -->
    <script
      src="https://chat.authority.org.cn/lead.js"
      data-site="authority-org-cn"
      data-lang="zh-CN"
      data-color="#1B3A2E"
      data-accent="#A88A3E"
      async></script>
  </body>
</html>
